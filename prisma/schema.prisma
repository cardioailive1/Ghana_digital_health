generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Facility {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  region    String
  type      String   @default("teaching")
  address   String?
  phone     String?
  nhiaId    String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  auditLogs AuditLog[] @relation("FacilityAuditLogs")
  sessions  Session[]  @relation("FacilitySessions")
  patients  Patient[]  @relation("FacilityPatients")
  encounters Encounter[] @relation("FacilityEncounters")

  @@map("facilities")
}

// ── Clinical models (FHIR R4 aligned) ─────────────────────────
model Patient {
  id          String    @id @default(uuid())
  mrn         String?   @unique                 // internal medical record number
  ghanaCard   String?   @unique
  nhis        String?
  firstName   String
  lastName    String
  sex         String?                           // male | female | other | unknown
  dob         DateTime?
  phone       String?
  region      String?
  district    String?
  facilityId  String?
  facility    Facility? @relation("FacilityPatients", fields: [facilityId], references: [id])
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  encounters   Encounter[]
  observations Observation[]
  conditions   Condition[]

  @@index([nhis])
  @@index([ghanaCard])
  @@index([lastName])
  @@map("patients")
}

model Encounter {
  id          String    @id @default(uuid())
  patientId   String
  patient     Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  facilityId  String?
  facility    Facility? @relation("FacilityEncounters", fields: [facilityId], references: [id])
  class       String    @default("AMB")         // AMB (outpatient) | IMP (inpatient) | EMER
  status      String    @default("in-progress") // planned|in-progress|finished|cancelled
  reason      String?
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  createdAt   DateTime  @default(now())

  observations Observation[]
  conditions   Condition[]

  @@index([patientId])
  @@map("encounters")
}

model Observation {
  id          String    @id @default(uuid())
  patientId   String
  patient     Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  encounterId String?
  encounter   Encounter? @relation(fields: [encounterId], references: [id])
  code        String                            // LOINC code
  display     String?
  value       String?
  unit        String?
  interpretation String?                        // N | A | H | L | AA (HL7 abnormal flags)
  status      String    @default("final")       // registered|preliminary|final|amended
  effectiveAt DateTime  @default(now())
  source      String    @default("manual")      // manual | hl7 | device
  createdAt   DateTime  @default(now())

  @@index([patientId])
  @@index([code])
  @@map("observations")
}

model Condition {
  id          String    @id @default(uuid())
  patientId   String
  patient     Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  encounterId String?
  encounter   Encounter? @relation(fields: [encounterId], references: [id])
  code        String                            // ICD-11 code
  display     String?
  clinicalStatus String @default("active")      // active | resolved | inactive
  recordedAt  DateTime  @default(now())
  createdAt   DateTime  @default(now())

  @@index([patientId])
  @@map("conditions")
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  name         String
  passwordHash String?
  role         String    @default("viewer")
  facilityId   String?
  facility     Facility? @relation(fields: [facilityId], references: [id])
  provider     String    @default("local")
  oauthId      String?
  mfaEnabled   Boolean   @default(false)
  mfaSecret    String?
  active       Boolean   @default(true)
  approvalStatus String  @default("pending")   // pending | approved | rejected
  approvedById String?
  approvedAt   DateTime?
  lastLogin    DateTime?
  loginCount   Int       @default(0)
  failedLogins Int       @default(0)
  lockedUntil  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions  Session[]
  auditLogs AuditLog[]
  chatLogs  ChatLog[]

  @@index([email])
  @@index([facilityId])
  @@index([role])
  @@index([approvalStatus])
  @@map("users")
}

model Session {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  facilityId String?
  facility   Facility? @relation("FacilitySessions", fields: [facilityId], references: [id])
  jti        String    @unique
  provider   String    @default("local")
  ipAddress  String?
  userAgent  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([jti])
  @@index([expiresAt])
  @@map("sessions")
}

model AuditLog {
  id           String    @id @default(uuid())
  action       String
  userId       String?
  user         User?     @relation(fields: [userId], references: [id])
  facilityId   String?
  facility     Facility? @relation("FacilityAuditLogs", fields: [facilityId], references: [id])
  resourceType String?
  resourceId   String?
  outcome      String    @default("success")
  ipAddress    String?
  userAgent    String?
  requestId    String?
  metadata     Json?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([facilityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model ChatLog {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  facilityId String?
  role       String
  content    String
  withPHI    Boolean  @default(false)
  tokenCount Int?
  model      String   @default("claude-haiku-4-5-20251001")
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([facilityId])
  @@index([createdAt])
  @@map("chat_logs")
}

model NhisClaim {
  id            String    @id @default(uuid())
  claimRef      String    @unique
  patientId     String
  facilityId    String
  icd11Code     String
  icdDesc       String
  amount        Decimal   @db.Decimal(10,2)
  status        String    @default("pending")
  nhiaRef       String?
  rejectionCode String?
  confidence    Int?
  submittedAt   DateTime?
  approvedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([facilityId])
  @@index([status])
  @@index([createdAt])
  @@map("nhis_claims")
}

model IoMTAlert {
  id             String    @id @default(uuid())
  deviceId       String
  patientRef     String
  facilityId     String
  alertType      String
  score          Int?
  level          String
  vitals         Json?
  acknowledgedBy String?
  acknowledgedAt DateTime?
  escalatedAt    DateTime?
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@index([facilityId])
  @@index([alertType])
  @@index([createdAt])
  @@map("iomt_alerts")
}
